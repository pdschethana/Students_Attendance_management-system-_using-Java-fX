<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f5f7fa;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ijse.javaprojectfx.controller.AdminDashboardController">

   <!-- Header Background -->
   <Label layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="900.0" style="-fx-background-color: #4a6baf;" />

   <!-- Header Title -->
   <Label layoutX="350.0" layoutY="20.0" text="Admin Dashboard" textFill="WHITE">
      <font><Font name="System Bold" size="28.0" /></font>
   </Label>

   <!-- Logout Button -->
   <Button fx:id="btnLogout" layoutX="800.0" layoutY="20.0" onAction="#logoutAction" prefHeight="40.0" prefWidth="80.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-border-color: white; -fx-border-radius: 4;" text="Logout" />

   <!-- Sidebar Background -->
   <Label layoutX="0.0" layoutY="80.0" prefHeight="520.0" prefWidth="250.0" style="-fx-background-color: #2c3e50;" />

   <!-- Sidebar Buttons -->
   <Button fx:id="btnDashboard" layoutX="25.0" layoutY="97.0" onAction="#dashboardOnAction" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;" text="Dashboard Overview">
      <font><Font name="System Bold" size="14.0" /></font>
   </Button>

   <Button fx:id="btnStudent" layoutX="25.0" layoutY="170.0" onAction="#studentmanageOnaction" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;" text="Student Management">
      <font><Font name="System Bold" size="14.0" /></font>
   </Button>

   <Button fx:id="btnCourse" layoutX="25.0" layoutY="230.0" onAction="#coursemanageOnaction" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;" text="Course Management">
      <font><Font name="System Bold" size="14.0" /></font>
   </Button>

   <Button fx:id="btnLecturer" layoutX="25.0" layoutY="290.0" onAction="#lecturemanagementOnAction" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;" text="Lecturer Management">
      <font><Font name="System Bold" size="14.0" /></font>
   </Button>

   <Button fx:id="btnSchedule" layoutX="25.0" layoutY="350.0" onAction="#classshedulOnAction" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;" text="Class Scheduling">
      <font><Font name="System Bold" size="14.0" /></font>
   </Button>

   <Button fx:id="btnAttendance" layoutX="25.0" layoutY="410.0" onAction="#attendancemanagementOnAction" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;" text="Attendance Management">
      <font><Font name="System Bold" size="14.0" /></font>
   </Button>

   <Button fx:id="btnReports" layoutX="25.0" layoutY="470.0" onAction="#reportonAction" prefHeight="45.0" prefWidth="200.0" style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-background-radius: 4;" text="Reports">
      <font><Font name="System Bold" size="14.0" /></font>
   </Button>

   <!-- Welcome Card -->
   <Label layoutX="270.0" layoutY="100.0" prefHeight="120.0" prefWidth="610.0" style="-fx-background-color: #4a6baf; -fx-background-radius: 8;" />

   <Label layoutX="290.0" layoutY="120.0" text="Welcome, Administrator" textFill="WHITE">
      <font><Font name="System Bold" size="20.0" /></font>
   </Label>

   <Label layoutX="290.0" layoutY="150.0" prefWidth="570.0" text="Manage your educational institution efficiently" textFill="WHITE" wrapText="true">
      <font><Font size="14.0" /></font>
   </Label>

   <!-- Stats: Students -->
   <Label layoutX="270.0" layoutY="240.0" prefHeight="100.0" prefWidth="190.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" />
   <Label layoutX="280.0" layoutY="260.0" prefWidth="170.0" text="60" textFill="#4a6baf">
      <font><Font name="System Bold" size="24.0" /></font>
   </Label>
   <Label layoutX="280.0" layoutY="300.0" prefWidth="170.0" text="Students" textFill="#7f8c8d">
      <font><Font size="14.0" /></font>
   </Label>

   <!-- Stats: Courses -->
   <Label layoutX="470.0" layoutY="240.0" prefHeight="100.0" prefWidth="190.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" />
   <Label layoutX="480.0" layoutY="260.0" prefWidth="170.0" text="5" textFill="#4a6baf">
      <font><Font name="System Bold" size="24.0" /></font>
   </Label>
   <Label layoutX="480.0" layoutY="300.0" prefWidth="170.0" text="Courses" textFill="#7f8c8d">
      <font><Font size="14.0" /></font>
   </Label>

   <!-- Stats: Lecturers -->
   <Label layoutX="670.0" layoutY="240.0" prefHeight="100.0" prefWidth="190.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" />
   <Label layoutX="680.0" layoutY="260.0" prefWidth="170.0" text="5" textFill="#4a6baf">
      <font><Font name="System Bold" size="24.0" /></font>
   </Label>
   <Label layoutX="680.0" layoutY="300.0" prefWidth="170.0" text="Lecturers" textFill="#7f8c8d">
      <font><Font size="14.0" /></font>
   </Label>

   <!-- Recent Activity -->
   <Label layoutX="270.0" layoutY="370.0" prefHeight="200.0" prefWidth="610.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" />
   <Label layoutX="290.0" layoutY="390.0" text="Recent Activity" textFill="#2c3e50">
      <font><Font name="System Bold" size="16.0" /></font>
   </Label>
   <Label layoutX="310.0" layoutY="420.0" text="• 5 new students enrolled today" textFill="#7f8c8d" />
   <Label layoutX="310.0" layoutY="450.0" text="• 2 new classes scheduled for tomorrow" textFill="#7f8c8d" />
   <Label layoutX="310.0" layoutY="480.0" text="• Attendance marked for 12 classes" textFill="#7f8c8d" />
   <Label layoutX="310.0" layoutY="510.0" text="• 3 new lecturers added this week" textFill="#7f8c8d" />

</AnchorPane>
