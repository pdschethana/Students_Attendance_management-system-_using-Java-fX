<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane onDragDetected="#gotologinpage" prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #3498db;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ijse.javaprojectfx.controller.LecturerDashboardController">

    <!-- Header -->
    <Label layoutX="20.0" layoutY="20.0" style="-fx-font-size: 22px; -fx-text-fill: #2C3E50;" text="📚 EduTrack - Lecturer Dashboard" textFill="#f4f0f0" />

    <!-- Welcome Label -->
    <Label fx:id="lblWelcome" layoutX="20.0" layoutY="60.0" style="-fx-font-size: 16px;" text="Welcome, Dr. [Lecturer Name]" />

    <!-- Buttons -->
    <Button fx:id="btnMarkAttendance" layoutX="300.0" layoutY="140.0" onAction="#Gotoattendancemanagementpage" prefHeight="32.0" prefWidth="250.0" text="📝 Mark Attendance" />

    <Button fx:id="btnViewReports" layoutX="300.0" layoutY="200.0" prefHeight="32.0" prefWidth="250.0" text="📊 View Attendance Reports" />

    <!-- Logout Button -->
    <Button fx:id="btnLogout" layoutX="650.0" layoutY="550.0" onAction="#gotologin" prefWidth="100.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="🚪 Logout" />
</AnchorPane>
